{
  "name": "FavoritaLista",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da lista de favoritos"
    },
    "descricao": {
      "type": "string",
      "description": "Descrição opcional da lista"
    },
    "cor": {
      "type": "string",
      "default": "blue",
      "description": "Cor para identificação visual (blue, green, red, purple, yellow, pink, orange)"
    },
    "ordem": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibição"
    }
  },
  "required": ["nome"],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
