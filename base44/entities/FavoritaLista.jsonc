{
  "name": "FavoritaLista",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da lista de favoritos"
    },
    "descricao": {
      "type": "string",
      "description": "Descrição opcional da lista"
    },
    "cor": {
      "type": "string",
      "default": "blue",
      "description": "Cor para identificação visual (blue, green, red, purple, yellow, pink, orange)"
    },
    "ordem": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibição"
    },
    "usuario_id": {
      "type": "string",
      "description": "ID do usuário individual que originalmente criou a lista. Legado — não controla mais o acesso, isso é feito por unidade_negocio_id."
    },
    "unidade_negocio_id": {
      "type": "string",
      "description": "ID da unidade de negócio dona deste registro. Controla o acesso: qualquer usuário da unidade enxerga o registro."
    }
  },
  "required": ["nome"],
  "rls": {
    "create": {
      "$or": [
        {
          "data.unidade_negocio_id": "{{user.data.unidade_negocio_id}}"
        },
        {
          "user_condition": {
            "email": "nailton.alsampaio@gmail.com"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.unidade_negocio_id": "{{user.data.unidade_negocio_id}}"
        },
        {
          "user_condition": {
            "email": "nailton.alsampaio@gmail.com"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.unidade_negocio_id": "{{user.data.unidade_negocio_id}}"
        },
        {
          "user_condition": {
            "email": "nailton.alsampaio@gmail.com"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.unidade_negocio_id": "{{user.data.unidade_negocio_id}}"
        },
        {
          "user_condition": {
            "email": "nailton.alsampaio@gmail.com"
          }
        }
      ]
    }
  }
}
