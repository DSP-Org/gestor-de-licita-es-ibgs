{
  "name": "Licitacao",
  "type": "object",
  "properties": {
    "id_licitacao": {
      "type": "string",
      "description": "Identificador \u00fanico da licita\u00e7\u00e3o na fonte externa"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo da licita\u00e7\u00e3o"
    },
    "objeto": {
      "type": "string",
      "description": "Objeto da licita\u00e7\u00e3o"
    },
    "uf": {
      "type": "string",
      "description": "Sigla do Estado"
    },
    "municipio": {
      "type": "string",
      "description": "Nome do munic\u00edpio"
    },
    "municipio_ibge": {
      "type": "string",
      "description": "C\u00f3digo IBGE do munic\u00edpio"
    },
    "orgao": {
      "type": "string",
      "description": "\u00d3rg\u00e3o respons\u00e1vel pela licita\u00e7\u00e3o"
    },
    "abertura_datetime": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora de abertura"
    },
    "abertura": {
      "type": "string",
      "description": "Data de abertura formatada"
    },
    "tipo": {
      "type": "string",
      "description": "Modalidade da licita\u00e7\u00e3o"
    },
    "id_tipo": {
      "type": "string",
      "description": "C\u00f3digo da modalidade"
    },
    "valor": {
      "type": "string",
      "description": "Valor estimado da licita\u00e7\u00e3o"
    },
    "link": {
      "type": "string",
      "description": "Link da licita\u00e7\u00e3o na fonte"
    },
    "link_externo": {
      "type": "string",
      "description": "Link do portal oficial"
    },
    "busca_origem": {
      "type": "string",
      "description": "Nome da busca que inseriu originalmente o registro global"
    },
    "data_sincronizacao": {
      "type": "string",
      "format": "date",
      "description": "Data da primeira sincroniza\u00e7\u00e3o"
    },
    "data_publicacao": {
      "type": "string",
      "description": "Data de publica\u00e7\u00e3o ou inser\u00e7\u00e3o"
    }
  },
  "required": [
    "id_licitacao",
    "titulo"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}