{
  "name": "Licitacao",
  "type": "object",
  "properties": {
    "id_licitacao": {
      "type": "string",
      "description": "Identificador \u00fanico da licita\u00e7\u00e3o no Alerta Licita\u00e7\u00e3o"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo da licita\u00e7\u00e3o"
    },
    "objeto": {
      "type": "string",
      "description": "Objeto da licita\u00e7\u00e3o"
    },
    "uf": {
      "type": "string",
      "description": "Sigla do Estado"
    },
    "municipio": {
      "type": "string",
      "description": "Nome do munic\u00edpio"
    },
    "municipio_ibge": {
      "type": "string",
      "description": "C\u00f3digo IBGE do munic\u00edpio"
    },
    "orgao": {
      "type": "string",
      "description": "\u00d3rg\u00e3o respons\u00e1vel pela licita\u00e7\u00e3o"
    },
    "abertura_datetime": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora de abertura"
    },
    "abertura": {
      "type": "string",
      "description": "Data de abertura formatada (dd/mm/aaaa)"
    },
    "tipo": {
      "type": "string",
      "description": "Modalidade da licita\u00e7\u00e3o (ex: Preg\u00e3o eletr\u00f4nico)"
    },
    "id_tipo": {
      "type": "string",
      "description": "C\u00f3digo da modalidade"
    },
    "valor": {
      "type": "string",
      "description": "Valor estimado da licita\u00e7\u00e3o"
    },
    "link": {
      "type": "string",
      "description": "Link da licita\u00e7\u00e3o no Alerta Licita\u00e7\u00e3o"
    },
    "link_externo": {
      "type": "string",
      "description": "Link externo (portal oficial)"
    },
    "status": {
      "type": "string",
      "enum": [
        "interessado",
        "acompanhando",
        "participando",
        "vencida",
        "ganha",
        "perdida",
        "descartada"
      ],
      "default": "interessado",
      "description": "Status de gest\u00e3o da licita\u00e7\u00e3o"
    },
    "favorito": {
      "type": "boolean",
      "default": false,
      "description": "Marcada como favorita"
    },
    "salva_manualmente": {
      "type": "boolean",
      "default": false,
      "description": "True se foi salva manualmente pelo usu\u00e1rio"
    },
    "notas": {
      "type": "string",
      "description": "Anota\u00e7\u00f5es internas sobre a licita\u00e7\u00e3o"
    },
    "valor_proposta": {
      "type": "number",
      "description": "Valor da proposta apresentada"
    },
    "busca_origem": {
      "type": "string",
      "description": "Nome da busca salva que originou este registro"
    },
    "usuario_id": {
      "type": "string",
      "description": "Usu\u00e1rio propriet\u00e1rio do resultado de sincroniza\u00e7\u00e3o autom\u00e1tica"
    },
    "unidade_negocio_id": {
      "type": "string",
      "description": "ID da unidade de neg\u00f3cio dona deste registro. Controla o acesso: qualquer usu\u00e1rio da unidade enxerga o registro."
    },
    "lista_favorita_id": {
      "type": "string",
      "description": "ID da lista de favoritos em que esta licitacao esta organizada"
    },
    "data_sincronizacao": {
      "type": "string",
      "format": "date",
      "description": "Data em que foi sincronizada (YYYY-MM-DD)"
    },
    "data_publicacao": {
      "type": "string",
      "description": "Data em que a licitação foi publicada/inserida (YYYY-MM-DD)"
    },
    "oculto": {
      "type": "boolean",
      "default": false,
      "description": "Descartada pelo usuario: some das listagens dele mas continua no banco. Apagar o registro de vez e restrito ao administrador."
    },
    "status_leitura": {
      "type": "string",
      "enum": ["nova", "vista", "lida"],
      "default": "nova",
      "description": "Status de leitura do usuario (nova, vista ou lida)"
    }
  },
  "required": [
    "id_licitacao",
    "titulo"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.unidade_negocio_id": "{{user.data.unidade_negocio_id}}"
        },
        {
          "user_condition": {
            "email": "nailton.alsampaio@gmail.com"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.unidade_negocio_id": "{{user.data.unidade_negocio_id}}"
        },
        {
          "user_condition": {
            "email": "nailton.alsampaio@gmail.com"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.unidade_negocio_id": "{{user.data.unidade_negocio_id}}"
        },
        {
          "user_condition": {
            "email": "nailton.alsampaio@gmail.com"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.unidade_negocio_id": "{{user.data.unidade_negocio_id}}"
        },
        {
          "user_condition": {
            "email": "nailton.alsampaio@gmail.com"
          }
        }
      ]
    }
  }
}