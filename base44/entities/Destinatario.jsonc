{
  "name": "Destinatario",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome do destinat\u00e1rio"
    },
    "email": {
      "type": "string",
      "description": "E-mail do destinat\u00e1rio"
    },
    "observacao": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o livre (empresa, cargo, etc.)"
    },
    "usuario_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio dono do contato. Permite que o administrador cadastre o destinat\u00e1rio em nome de outro usu\u00e1rio, diferente de created_by_id (quem efetivamente criou o registro)."
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "usuario_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "usuario_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "usuario_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}