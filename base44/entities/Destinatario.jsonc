{
  "name": "Destinatario",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome do destinat\u00e1rio"
    },
    "email": {
      "type": "string",
      "description": "E-mail do destinat\u00e1rio"
    },
    "observacao": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o livre (empresa, cargo, etc.)"
    },
    "usuario_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio individual que originalmente cadastrou o contato. Legado \u2014 n\u00e3o controla mais o acesso, isso \u00e9 feito por unidade_negocio_id."
    },
    "unidade_negocio_id": {
      "type": "string",
      "description": "ID da unidade de neg\u00f3cio dona deste registro. Controla o acesso: qualquer usu\u00e1rio da unidade enxerga o registro."
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.unidade_negocio_id": "{{user.data.unidade_negocio_id}}"
        },
        {
          "user_condition": {
            "email": "nailton.alsampaio@gmail.com"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.unidade_negocio_id": "{{user.data.unidade_negocio_id}}"
        },
        {
          "user_condition": {
            "email": "nailton.alsampaio@gmail.com"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.unidade_negocio_id": "{{user.data.unidade_negocio_id}}"
        },
        {
          "user_condition": {
            "email": "nailton.alsampaio@gmail.com"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.unidade_negocio_id": "{{user.data.unidade_negocio_id}}"
        },
        {
          "user_condition": {
            "email": "nailton.alsampaio@gmail.com"
          }
        }
      ]
    }
  }
}