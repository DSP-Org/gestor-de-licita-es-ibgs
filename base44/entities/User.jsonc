{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "Perfil do usu\u00e1rio no aplicativo",
      "enum": [
        "admin",
        "user"
      ]
    },
    "approval_status": {
      "type": "string",
      "description": "Situa\u00e7\u00e3o da libera\u00e7\u00e3o de acesso pelo administrador",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    }
  },
  "required": [
    "role"
  ]
}