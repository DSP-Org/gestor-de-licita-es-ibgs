{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "Perfil do usu\u00e1rio no aplicativo",
      "enum": [
        "admin",
        "user"
      ]
    },
    "approval_status": {
      "type": "string",
      "description": "Situa\u00e7\u00e3o da libera\u00e7\u00e3o de acesso pelo administrador",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "unidade_negocio_id": {
      "type": "string",
      "description": "ID da unidade de neg\u00f3cio ATIVA do usu\u00e1rio no momento. \u00c9 este campo que o RLS das entidades com dono compara \u2014 define quais dados (licita\u00e7\u00f5es, buscas, favoritos, destinat\u00e1rios) o usu\u00e1rio enxerga agora. S\u00f3 pode ser trocado para uma unidade presente em unidades_negocio_ids (refor\u00e7ado pela fun\u00e7\u00e3o trocarUnidadeAtiva, n\u00e3o edit\u00e1vel livremente pelo pr\u00f3prio usu\u00e1rio)."
    },
    "unidades_negocio_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Lista de unidades de neg\u00f3cio \u00e0s quais o usu\u00e1rio tem permiss\u00e3o de pertencer. Controla entre quais unidades o usu\u00e1rio pode alternar como ativa (unidade_negocio_id)."
    }
  },
  "required": [
    "role"
  ],
  "rls": {
    "read": true,
    "update": {
      "user_condition": {
        "email": "nailton.alsampaio@gmail.com"
      }
    }
  }
}