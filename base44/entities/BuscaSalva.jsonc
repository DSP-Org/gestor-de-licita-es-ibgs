{
  "name": "BuscaSalva",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome identificador da busca salva"
    },
    "uf": {
      "type": "string",
      "description": "Sigla(s) do(s) Estado(s), separadas por v\u00edrgula (ex: PR,SC)"
    },
    "palavra_chave": {
      "type": "string",
      "description": "Palavras-chave separadas por v\u00edrgula. Use aspas para sequ\u00eancias e - para excluir."
    },
    "modo_palavras": {
      "type": "string",
      "enum": [
        "qualquer",
        "todas"
      ],
      "default": "qualquer",
      "description": "qualquer = expansivo; todas = restritivo"
    },
    "modalidade": {
      "type": "string",
      "description": "C\u00f3digos de modalidade separados por v\u00edrgula (ex: 5,13)"
    },
    "municipio_nome": {
      "type": "string",
      "description": "Nome do munic\u00edpio selecionado"
    },
    "municipio_ibge": {
      "type": "string",
      "description": "C\u00f3digo IBGE do munic\u00edpio (7 d\u00edgitos)"
    },
    "licitacoes_por_pagina": {
      "type": "number",
      "default": 50,
      "description": "Licita\u00e7\u00f5es por p\u00e1gina (1 a 100)"
    },
    "ativa": {
      "type": "boolean",
      "default": true,
      "description": "Se a busca est\u00e1 ativa para sincroniza\u00e7\u00e3o autom\u00e1tica"
    },
    "horario_sincronizacao": {
      "type": "string",
      "default": "09:00",
      "description": "Hor\u00e1rio HH:mm da sincroniza\u00e7\u00e3o autom\u00e1tica di\u00e1ria. Precisa coincidir com um dos hor\u00e1rios do cron do workflow Sincroniza\u00e7\u00e3o Di\u00e1ria, sen\u00e3o a busca nunca \u00e9 processada."
    },
    "notificar_email": {
      "type": "boolean",
      "default": true,
      "description": "Se envia e-mail autom\u00e1tico ao encontrar novas licita\u00e7\u00f5es"
    },
    "destinatarios_email": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Endere\u00e7os de e-mail que receber\u00e3o a notifica\u00e7\u00e3o, escolhidos na agenda Destinatario do dono da busca. Registros antigos podem conter IDs de User; a fun\u00e7\u00e3o sincronizarBuscas aceita ambos os formatos."
    },
    "destinatarios_extras": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Endere\u00e7os de e-mail externos que receber\u00e3o a notifica\u00e7\u00e3o"
    },
    "telegram_chats": {
      "type": "string",
      "description": "IDs de chat do Telegram separados por v\u00edrgula"
    },
    "ultima_sincronizacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data da \u00faltima sincroniza\u00e7\u00e3o"
    },
    "total_encontrado": {
      "type": "number",
      "description": "Total de licita\u00e7\u00f5es encontrado na \u00faltima sincroniza\u00e7\u00e3o"
    },
    "usuario_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio individual dono da busca para fins de notifica\u00e7\u00e3o (destinat\u00e1rio padr\u00e3o quando destinatarios_email est\u00e1 vazio). N\u00e3o controla mais o acesso \u2014 isso \u00e9 feito por unidade_negocio_id."
    },
    "unidade_negocio_id": {
      "type": "string",
      "description": "ID da unidade de negócio dona deste registro. Controla o acesso: qualquer usuário da unidade enxerga o registro."
    },
    "ultima_execucao_status": {
      "type": "string",
      "enum": [
        "sucesso",
        "erro",
        "em_andamento"
      ],
      "description": "Status da última execução da sincronização (sucesso, erro, em_andamento)"
    },
    "ultimo_erro": {
      "type": "string",
      "description": "Mensagem detalhada do último erro ocorrido durante a sincronização desta busca"
    }
  },
  "required": [
    "nome"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.unidade_negocio_id": "{{user.data.unidade_negocio_id}}"
        },
        {
          "user_condition": {
            "email": "nailton.alsampaio@gmail.com"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.unidade_negocio_id": "{{user.data.unidade_negocio_id}}"
        },
        {
          "user_condition": {
            "email": "nailton.alsampaio@gmail.com"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.unidade_negocio_id": "{{user.data.unidade_negocio_id}}"
        },
        {
          "user_condition": {
            "email": "nailton.alsampaio@gmail.com"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.unidade_negocio_id": "{{user.data.unidade_negocio_id}}"
        },
        {
          "user_condition": {
            "email": "nailton.alsampaio@gmail.com"
          }
        }
      ]
    }
  }
}