{
  "name": "BuscaSalva",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome identificador da busca salva"
    },
    "uf": {
      "type": "string",
      "description": "Sigla(s) do(s) Estado(s), separadas por v\u00edrgula (ex: PR,SC)"
    },
    "palavra_chave": {
      "type": "string",
      "description": "Palavras-chave separadas por v\u00edrgula. Use aspas para sequ\u00eancias e - para excluir."
    },
    "modo_palavras": {
      "type": "string",
      "enum": [
        "qualquer",
        "todas"
      ],
      "default": "qualquer",
      "description": "qualquer = expansivo; todas = restritivo"
    },
    "modalidade": {
      "type": "string",
      "description": "C\u00f3digos de modalidade separados por v\u00edrgula (ex: 5,13)"
    },
    "municipio_nome": {
      "type": "string",
      "description": "Nome do munic\u00edpio selecionado"
    },
    "municipio_ibge": {
      "type": "string",
      "description": "C\u00f3digo IBGE do munic\u00edpio (7 d\u00edgitos)"
    },
    "licitacoes_por_pagina": {
      "type": "number",
      "default": 50,
      "description": "Licita\u00e7\u00f5es por p\u00e1gina (1 a 100)"
    },
    "ativa": {
      "type": "boolean",
      "default": true,
      "description": "Se a busca est\u00e1 ativa para sincroniza\u00e7\u00e3o autom\u00e1tica"
    },
    "horario_sincronizacao": {
      "type": "string",
      "default": "09:00",
      "description": "Hor\u00e1rio HH:mm da sincroniza\u00e7\u00e3o autom\u00e1tica di\u00e1ria"
    },
    "notificar_email": {
      "type": "boolean",
      "default": true,
      "description": "Se envia e-mail autom\u00e1tico ao encontrar novas licita\u00e7\u00f5es"
    },
    "destinatarios_email": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de usu\u00e1rios cadastrados que receber\u00e3o a notifica\u00e7\u00e3o por e-mail"
    },
    "destinatarios_extras": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Endere\u00e7os de e-mail externos que receber\u00e3o a notifica\u00e7\u00e3o"
    },
    "telegram_chats": {
      "type": "string",
      "description": "IDs de chat do Telegram separados por v\u00edrgula"
    },
    "ultima_sincronizacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data da \u00faltima sincroniza\u00e7\u00e3o"
    },
    "total_encontrado": {
      "type": "number",
      "description": "Total de licita\u00e7\u00f5es encontrado na \u00faltima sincroniza\u00e7\u00e3o"
    },
    "usuario_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio para quem esta busca foi configurada. Permite que um administrador configure a busca em nome de outro usu\u00e1rio (o dono real da busca, usado na sincroniza\u00e7\u00e3o e notifica\u00e7\u00f5es), diferente de created_by_id (quem efetivamente criou o registro)."
    }
  },
  "required": [
    "nome"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "usuario_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "email": "nailton.alsampaio@gmail.com"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "usuario_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "email": "nailton.alsampaio@gmail.com"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "usuario_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "email": "nailton.alsampaio@gmail.com"
          }
        }
      ]
    }
  }
}