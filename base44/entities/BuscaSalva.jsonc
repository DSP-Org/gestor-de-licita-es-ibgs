{
  "name": "BuscaSalva",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome identificador da busca salva"
    },
    "fonte": {
      "type": "string",
      "enum": [
        "alerta_licitacao",
        "pncp"
      ],
      "default": "alerta_licitacao",
      "description": "Fonte usada pela sincroniza\u00e7\u00e3o: Alerta Licita\u00e7\u00e3o ou PNCP"
    },
    "uf": {
      "type": "string",
      "description": "Sigla(s) do(s) Estado(s), separadas por v\u00edrgula"
    },
    "palavra_chave": {
      "type": "string",
      "description": "Palavras-chave separadas por v\u00edrgula"
    },
    "modo_palavras": {
      "type": "string",
      "enum": [
        "qualquer",
        "todas"
      ],
      "default": "qualquer",
      "description": "qualquer = expansivo; todas = restritivo"
    },
    "modalidade": {
      "type": "string",
      "description": "C\u00f3digos de modalidade separados por v\u00edrgula"
    },
    "municipio_nome": {
      "type": "string",
      "description": "Nome do munic\u00edpio selecionado"
    },
    "municipio_ibge": {
      "type": "string",
      "description": "C\u00f3digo(s) IBGE do munic\u00edpio, separados por v\u00edrgula"
    },
    "licitacoes_por_pagina": {
      "type": "number",
      "default": 50,
      "description": "Licita\u00e7\u00f5es por p\u00e1gina"
    },
    "ativa": {
      "type": "boolean",
      "default": true,
      "description": "Se a busca est\u00e1 ativa para sincroniza\u00e7\u00e3o autom\u00e1tica"
    },
    "horario_sincronizacao": {
      "type": "string",
      "default": "09:00",
      "description": "Hor\u00e1rio HH:mm da sincroniza\u00e7\u00e3o autom\u00e1tica di\u00e1ria"
    },
    "notificar_email": {
      "type": "boolean",
      "default": true,
      "description": "Se envia e-mail autom\u00e1tico ao encontrar novas licita\u00e7\u00f5es"
    },
    "destinatarios_email": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Endere\u00e7os de e-mail que receber\u00e3o a notifica\u00e7\u00e3o"
    },
    "destinatarios_extras": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Endere\u00e7os de e-mail externos que receber\u00e3o a notifica\u00e7\u00e3o"
    },
    "telegram_chats": {
      "type": "string",
      "description": "IDs de chat do Telegram separados por v\u00edrgula"
    },
    "ultima_sincronizacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data da \u00faltima sincroniza\u00e7\u00e3o"
    },
    "total_encontrado": {
      "type": "number",
      "description": "Total de licita\u00e7\u00f5es encontrado na \u00faltima sincroniza\u00e7\u00e3o"
    },
    "usuario_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio dono da busca para notifica\u00e7\u00f5es"
    },
    "unidade_negocio_id": {
      "type": "string",
      "description": "ID da unidade de neg\u00f3cio dona do alerta"
    },
    "ultima_execucao_status": {
      "type": "string",
      "enum": [
        "sucesso",
        "erro",
        "em_andamento"
      ],
      "description": "Status da \u00faltima execu\u00e7\u00e3o"
    },
    "ultimo_erro": {
      "type": "string",
      "description": "Mensagem detalhada do \u00faltimo erro"
    }
  },
  "required": [
    "nome"
  ],
  "rls": {
    "create": {
      "data.unidade_negocio_id": "{{user.data.unidade_negocio_id}}"
    },
    "read": {
      "data.unidade_negocio_id": "{{user.data.unidade_negocio_id}}"
    },
    "update": {
      "data.unidade_negocio_id": "{{user.data.unidade_negocio_id}}"
    },
    "delete": {
      "data.unidade_negocio_id": "{{user.data.unidade_negocio_id}}"
    }
  }
}