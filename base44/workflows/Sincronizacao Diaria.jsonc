{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 6,9,12,15,18 * * 1-5",
      "one_time_date": null,
      "timezone": "America/Sao_Paulo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Dispara nos hor\u00e1rios oferecidos pela interface (06, 09, 12, 15 e 18h, seg-sex). A fun\u00e7\u00e3o sincronizarBuscas processa apenas as buscas cujo horario_sincronizacao corresponde \u00e0 hora do disparo. Ao incluir um novo hor\u00e1rio aqui, adicione-o tamb\u00e9m em HORARIOS_SINCRONIZACAO (src/shared/alertaApi.js).",
  "name": "Sincroniza\u00e7\u00e3o Di\u00e1ria de Buscas",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sincronizacao_diaria",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sincronizar": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sincronizarBuscas"
          },
          "then": "end",
          "x-base44": {
            "title": "Sincronizar buscas ativas",
            "description": "Consulta a API e importa novas licita\u00e7\u00f5es"
          }
        }
      }
    ]
  }
}