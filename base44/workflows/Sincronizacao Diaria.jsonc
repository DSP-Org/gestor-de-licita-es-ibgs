  "description": "Sincroniza automaticamente todas as buscas salvas ativas, importa novas licita\u00e7\u00f5es e notifica os usu\u00e1rios por e-mail",
  "name": "Sincroniza\u00e7\u00e3o Di\u00e1ria de Buscas",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sincronizacao_diaria",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sincronizar": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sincronizarBuscas"
          },
          "then": "end",
          "x-base44": {
            "title": "Sincronizar buscas ativas",
            "description": "Consulta a API e importa novas licita\u00e7\u00f5es"
          }
        }
      }
    ]
  }
